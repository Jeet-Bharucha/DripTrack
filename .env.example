# Copy this to backend/.env and fill in your real values
# On Railway: add these in the Variables tab (not as a file)

RAINFOREST_API_KEY=your_rainforest_key_here
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
SERPAPI_KEY=your_serpapi_key_here
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=DripTrack
JWT_SECRET=change_this_to_a_long_random_string
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Production only — set to your Railway URL e.g. https://driptrack.railway.app
GOOGLE_REDIRECT_URI=
